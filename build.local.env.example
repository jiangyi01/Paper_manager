# Copy this file to build.local.env (git-ignored) and uncomment what you need.
# One KEY=VALUE per line; # starts a comment; quotes are optional. The file is read as data — never
# sourced — and only these keys are accepted (a typo stops the build). PAPERDECK_* environment
# variables override this file, and ./build_app.sh flags override both.
# ./build_app.sh --print-config shows the result without building anything.

# Bundle id (reverse DNS). Changing it starts a fresh settings domain, keychain service,
# permissions and widget: settings don't carry over from a build with another id. It is not a
# separate copy: every id shares one library, database, caches, widget data, URL scheme and
# single-instance lock, so two copies can't run together (docs/BUILDING.md).
#PAPERDECK_BUNDLE_ID=org.example.paperdeck

# Widget extension id; must start with the bundle id + "." (default: <bundle id>.widget).
#PAPERDECK_WIDGET_ID=org.example.paperdeck.widget

# Code-signing identity: a certificate name, its SHA-1, or - for ad-hoc. Default: the
# self-signed certificate name printed by --print-config (see docs/BUILDING.md to create it).
#PAPERDECK_SIGN_IDENTITY=My PaperDeck Signing

# Where the app is installed (default /Applications). ~/ means your home folder.
#PAPERDECK_INSTALL_DIR=~/Applications

# Keychain service for IMAP app passwords (default: <bundle id>.mail).
#PAPERDECK_KEYCHAIN_SERVICE=org.example.paperdeck.mail

# local (built on this Mac: Settings shows build instructions) or distribution. --package sets distribution.
#PAPERDECK_CHANNEL=local

# Parallel build jobs (swift build -j N; also used for ./build_app.sh --test).
#PAPERDECK_JOBS=8

# For ./test.sh: the folder that contains Frameworks/Testing.framework (default: the Command
# Line Tools location, else derived from xcode-select -p).
#PAPERDECK_DEV_DIR=/Library/Developer/CommandLineTools/Library/Developer
