<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- pkd refuses unsandboxed plug-ins ("plug-ins must be sandboxed"). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- No Team ID → no App Group. The host writes a JSON snapshot here; the widget only reads it. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/PaperDeck/widget/</string>
	</array>
</dict>
</plist>
